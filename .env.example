# --- Supabase Auth / API (Project Settings → API) ---
# Project URL — dipakai Supabase JS client di browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon/public key — aman diekspos ke client (dibatasi RLS). Jangan pakai service role di sini.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — bypass RLS. HANYA server-side, JANGAN pernah diekspos ke client/bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Supabase Postgres (Project Settings → Database → Connection string) ---
# DIRECT_URL dipakai drizzle-kit untuk migrasi.
#   - Idealnya "Direct connection" (db.xxx.supabase.co:5432), tapi itu IPv6-only
#     dan butuh IPv4 add-on di jaringan IPv4.
#   - Alternatif praktis: "Session pooler" (port 5432, IPv4) yang mendukung DDL.
#     Contoh di bawah pakai session pooler.
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# DATABASE_URL = Transaction pooler (port 6543) — dipakai runtime app
# (postgres-js) di serverless/Vercel agar hemat koneksi (IPv4).
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Resend (https://resend.com/api-keys) — email reminders, Phase 2 ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Vercel Cron — sent as `Authorization: Bearer <CRON_SECRET>` to /api/cron/*, Phase 2 ---
CRON_SECRET=generate-a-long-random-string

# --- OpenRouter (https://openrouter.ai/keys) — Phase 4 AI chat streaming ---
# Required for /api/chat to stream responses (Vercel AI SDK +
# @openrouter/ai-sdk-provider). Read server-side only — never exposed
# to the client bundle. If unset, the chat UI shows a "not configured"
# banner. Free models (e.g. google/gemma-4-26b-a4b:free) work without
# adding credits; paid models need balance on the account.
OPENROUTER_API_KEY=your-openrouter-api-key
