# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Drizzle / direct Postgres (Supabase → Project Settings → Database → Connection string) ---
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# --- Resend (https://resend.com/api-keys) — email reminders, Phase 2 ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Vercel Cron — sent as `Authorization: Bearer <CRON_SECRET>` to /api/cron/*, Phase 2 ---
CRON_SECRET=generate-a-long-random-string
